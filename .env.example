# ===================== 抖音 / 浏览器 =====================
# 需要自动回复的对方用户，逗号分隔；可写昵称或抖音号/uid。
# 特殊值 self = 当前机器人账号的主人（即你自己）。默认 self。
DOUYIN_TARGET_USERS=self
# 你自己的昵称 / 抖音号，用来把 "self" 解析成具体会话（建议填写）
DOUYIN_OWNER_NAME=
# 抖音网页版私信入口（以实际探测为准）
DOUYIN_CHAT_URL=https://www.douyin.com/chat
# 浏览器登录态目录（持久化 cookie，切勿提交）
DOUYIN_PROFILE_DIR=.douyin-profile
# 是否无头运行；首次登录必须 false 以便扫码
HEADLESS=false
# watch 模式轮询间隔（毫秒），带随机抖动
POLL_INTERVAL_MS=15000
# true = 只生成回复并打印，不真正发送
DRY_RUN=true
# 运行数据目录（媒体下载、已处理消息记录、DOM 快照）
DATA_DIR=data

# ===================== LLM =====================
# grok | openai
PROVIDER=grok

# --- Grok (xAI) ---
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4

# --- OpenAI 兼容接口（OpenAI / Azure 代理 / 本地 vLLM / OneAPI 等） ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 回复风格预设：casual | warm | terse | roast（改这一行即可切换）
REPLY_STYLE=casual
# 自定义系统提示词（可选；非空时覆盖上面的 REPLY_STYLE 预设）
REPLY_SYSTEM_PROMPT=
# 每个视频抽取的关键帧数量（需要本机安装 ffmpeg）
VIDEO_FRAME_COUNT=6
# 分享图集最多取几张原图；分享视频下载上限（MB，自动选最小码率 mp4）
ALBUM_MAX_IMAGES=9
VIDEO_MAX_MB=80
# 单次请求超时（毫秒）
LLM_TIMEOUT_MS=90000

# ===================== 视频音轨转写 =====================
# true = 下载视频后用 ffmpeg 抽音轨并转写（旁白/对白）
TRANSCRIBE_ENABLED=true
# auto | grok | openai；auto = 优先 Grok STT（/v1/stt），否则 OpenAI Whisper
TRANSCRIBE_PROVIDER=auto
# 覆盖模型：Grok 默认 grok-voice-transcribe-2.0；OpenAI 默认 whisper-1
TRANSCRIBE_MODEL=
# 语言偏置，如 zh / en；留空自动检测
TRANSCRIBE_LANGUAGE=zh
# 转写前截断音轨秒数；0 = 不截断（默认 600）
TRANSCRIBE_MAX_SECONDS=600

