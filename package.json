{
  "name": "douyin-dm-bot",
  "version": "0.1.0",
  "private": true,
  "description": "抖音私信自动回复机器人（Playwright 浏览器自动化 + 多模态 LLM：Grok / OpenAI 兼容接口）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js watch",
    "login": "tsx src/index.ts login",
    "once": "tsx src/index.ts once",
    "watch": "tsx src/index.ts watch",
    "probe": "tsx src/index.ts probe",
    "postinstall": "playwright install chromium"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.5",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
